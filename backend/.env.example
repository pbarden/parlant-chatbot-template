# Copy to backend/.env and set these
APP_ENV=dev
APP_DEBUG=true
APP_API_V1_STR=/api/v1
APP_PROJECT_NAME=YOUR_COMPANY Chat Platform
APP_BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://localhost:3000"]

# Database
APP_SQLALCHEMY_DATABASE_URI=postgresql+psycopg://postgres:postgres@db:5432/chatdb

# External services
APP_PARLANT_BASE_URL=http://localhost:8800
APP_OPENAI_API_KEY=sk-***

# Security
APP_PUBLIC_TOKEN_SECRET=change-this-secret

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json